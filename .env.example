# Kopeeri see fail nimega .env ja muuda väärtused (.env ei lähe Giti).
# Need on ainult kohaliku arenduskeskkonna väärtused.

POSTGRES_DB=kino
POSTGRES_USER=kino
POSTGRES_PASSWORD=muuda-see-parool

# Pordid sinu arvutis (5433/8001, et mitte segada teisi projekte 5432/8000 peal)
POSTGRES_HOST_PORT=5433
BACKEND_HOST_PORT=8001

# Django salajane võti – genereeri oma, nt:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=muuda-see-pikaks-juhuslikuks-vaartuseks
DJANGO_DEBUG=1
